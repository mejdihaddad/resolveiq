# Copy this file to .env and add your own local credentials.
# Never commit .env or put real API keys in this template.

# Required only when running live similar-case retrieval.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=3072

# NYC 311 public API configuration.
NYC311_BASE_URL=https://data.cityofnewyork.us/resource
NYC311_DATASET_ID=erm2-nwe9

# Local Qdrant service.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=resolveiq-cases-collection-00
QDRANT_COLLECTION_CASES=resolveiq-cases-collection-01

# Optional tracing. Leave disabled unless configured.
RESOLVEIQ_LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=resolveiq-triage

# Optional Langfuse settings, if used by your local environment.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
